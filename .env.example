# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Comma-separated browser origins allowed to call the Express API in production.
# Example: https://gauseva-connect.pages.dev,https://www.example.com
CORS_ORIGINS=""

# Cloudflare Turnstile (bot protection on contact form)
# Create a widget at https://dash.cloudflare.com → Turnstile
VITE_TURNSTILE_SITE_KEY=""
# Server secret (Cloudflare Pages secret) — when set, contact form requires valid captcha
TURNSTILE_SECRET_KEY=""

# Admin emergency password fallback (server-only — do NOT use VITE_ prefix in production).
# Leave empty to disable password login; use Firebase admin email login instead.
ADMIN_USER=""
ADMIN_PASS=""
# Deprecated: never ship admin secrets as VITE_* (they end up in the browser bundle).
# VITE_ADMIN_USER=""
# VITE_ADMIN_PASS=""

# Google Drive Integration for Verification Documents
# 1. Enable Google Drive API in Google Cloud Console
# 2. Create a Service Account and generate a JSON key. Minify the JSON and paste here.
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=""

# 3. Create a folder in your personal Google Drive, share it with the service account email, and put the folder ID here.
GOOGLE_DRIVE_FOLDER_ID=""

# OpenRouter API Key for AI Cow Breed & Health Analysis (Using Gemma 4)
OPENROUTER_API_KEY=""

# Frontend: Connection to Express Backend (Railway)
VITE_BACKEND_URL="http://localhost:3000"

# Frontend: Optional Firebase configuration overrides for production deployment (e.g. Vercel)
# If not specified, the app falls back to loading from firebase-applet-config.json
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Backend: Cloudflare R2 configurations (for generating presigned upload URLs)
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL_PREFIX="https://pub-xxxxxx.r2.dev"

